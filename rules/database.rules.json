{
  "rules": {
    ".read": false,
    ".write": false,

    "gameIndex": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous'",
      ".indexOn": ["at"],
      "$pin": {
        ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && ((!data.exists() && newData.child('host').val() === auth.uid && root.child('games/' + $pin + '/meta/host').val() === auth.uid) || (data.exists() && !newData.exists() && (data.child('host').val() === auth.uid || data.child('at').val() < now - 86400000)))",
        ".validate": "newData.hasChildren(['host', 'at']) && newData.child('at').val() === now"
      }
    },

    "games": {
      "$pin": {
        ".validate": "$pin.matches(/^[1-9][0-9]{5}$/)",
        ".write": "auth != null && !newData.exists() && (data.child('meta/host').val() === auth.uid || (auth.token.firebase.sign_in_provider != 'anonymous' && data.child('meta/createdAt').val() < now - 86400000))",

        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && newData.child('host').val() === auth.uid && (!data.exists() || data.child('host').val() === auth.uid)",
          ".validate": "newData.hasChildren(['host', 'quizId', 'title', 'mode', 'status', 'settings', 'count', 'createdAt'])",
          "host": { ".validate": "newData.isString()" },
          "quizId": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "title": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "mode": { ".validate": "newData.isString() && newData.val().matches(/^(classic|lasertag|robotrun|spacecraft|obby)$/)" },
          "status": { ".validate": "newData.val() === 'lobby' || newData.val() === 'play' || newData.val() === 'end'" },
          "count": { ".validate": "newData.isNumber()" },
          "createdAt": { ".validate": "(!data.exists() && newData.isNumber() && newData.val() > now - 120000 && newData.val() < now + 120000) || newData.val() === data.val()" },
          "startAt": { ".validate": "newData.isNumber()" },
          "endsAt": { ".validate": "newData.isNumber()" },
          "endedAt": { ".validate": "newData.isNumber()" },
          "hostOn": { ".validate": "newData.isBoolean()" },
          "reported": { ".validate": "newData.isBoolean()" },
          "settings": {
            "speed": { ".validate": "newData.isBoolean()" },
            "minutes": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30" },
            "shuffle": { ".validate": "newData.isBoolean()" },
            "lateJoin": { ".validate": "newData.isBoolean()" },
            "randomNames": { ".validate": "newData.isBoolean()" },
            "showText": { ".validate": "newData.isBoolean()" },
            "locked": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        },

        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && ((auth.uid === $uid && ((!data.exists() && newData.exists() && root.child('games/' + $pin + '/meta').exists() && !root.child('games/' + $pin + '/kicked/' + $uid).exists() && root.child('games/' + $pin + '/meta/settings/locked').val() !== true && (root.child('games/' + $pin + '/meta/status').val() === 'lobby' || (root.child('games/' + $pin + '/meta/status').val() === 'play' && root.child('games/' + $pin + '/meta/settings/lateJoin').val() === true))) || !newData.exists())) || (root.child('games/' + $pin + '/meta/host').val() === auth.uid && !newData.exists()))",
            ".validate": "newData.hasChildren(['name', 'blook', 'at'])",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16" },
            "blook": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "at": { ".validate": "newData.val() === now" },
            "$other": { ".validate": false }
          }
        },

        "kicked": {
          ".read": "auth != null && root.child('games/' + $pin + '/meta/host').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && root.child('games/' + $pin + '/meta/host').val() === auth.uid",
            ".validate": "newData.isBoolean()"
          }
        },

        "ans": {
          ".read": "auth != null && root.child('games/' + $pin + '/meta/host').val() === auth.uid",
          "$id": {
            ".write": "auth != null && !data.exists() && newData.child('u').val() === auth.uid && root.child('games/' + $pin + '/players/' + auth.uid).exists() && root.child('games/' + $pin + '/meta/status').val() === 'play'",
            ".validate": "newData.hasChildren(['u', 'q', 'c', 't']) && newData.child('t').val() === now",
            "u": { ".validate": "newData.isString()" },
            "q": { ".validate": "newData.isNumber()" },
            "s": { ".validate": "newData.isNumber()" },
            "t": { ".validate": "newData.isNumber()" },
            "c": { ".validate": "!newData.isString() || newData.val().length <= 80" },
            "$other": { ".validate": false }
          }
        },

        "act": {
          ".read": "auth != null && root.child('games/' + $pin + '/meta/host').val() === auth.uid",
          "$id": {
            ".write": "auth != null && !data.exists() && newData.child('u').val() === auth.uid && root.child('games/' + $pin + '/players/' + auth.uid).exists() && root.child('games/' + $pin + '/meta/status').val() === 'play'",
            ".validate": "newData.hasChildren(['u', 'k', 't']) && newData.child('t').val() === now",
            "u": { ".validate": "newData.isString()" },
            "k": { ".validate": "newData.isString() && newData.val().length <= 4" },
            "a": { ".validate": "newData.isNumber()" },
            "h": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "t": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "prog": {
          ".read": "auth != null && root.child('games/' + $pin + '/meta/host').val() === auth.uid",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('games/' + $pin + '/players/' + $uid).exists()",
            "$field": { ".validate": "$field.length <= 2 && newData.isNumber()" }
          }
        },

        "res": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && root.child('games/' + $pin + '/meta/host').val() === auth.uid"
          }
        },

        "me": {
          ".read": "auth != null && root.child('games/' + $pin + '/meta/host').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && root.child('games/' + $pin + '/meta/host').val() === auth.uid"
          }
        },

        "$public": {
          ".read": "auth != null && ($public === 'qs' || $public === 'cur' || $public === 'top' || $public === 'final' || $public === 'snap' || $public === 'race' || $public === 'tower' || $public === 'order')",
          ".write": "auth != null && root.child('games/' + $pin + '/meta/host').val() === auth.uid && ($public === 'qs' || $public === 'cur' || $public === 'top' || $public === 'final' || $public === 'snap' || $public === 'race' || $public === 'tower' || $public === 'order')"
        }
      }
    }
  }
}
