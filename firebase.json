{
  "hosting": [
    {
      "public": ".",
      "site": "compactcoding",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "tests/**",
        "server.mjs",
        "package.json",
        "package-lock.json",
        "README.md",
        "react/**",
        "scripts/**"
      ],
      "cleanUrls": true,
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.@(js|css|svg|webmanifest)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "site": "akylduukodo",
      "public": "scripts/redirect-site",
      "redirects": [
        {
          "source": "/:path*",
          "destination": "https://compactcoding.web.app/:path*",
          "type": 301
        }
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  }
}
